Total Revenue = SUM(Orders[revenue])
Total Profit = SUM(Orders[profit])
Total Orders = DISTINCTCOUNT(Orders[order_id])
Total Customers = DISTINCTCOUNT(Orders[customer_id])
Average Order Value = DIVIDE([Total Revenue], [Total Orders])
Profit Margin = DIVIDE([Total Profit], [Total Revenue])
Previous Year Revenue = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Calendar'[Date]))
YoY Growth = DIVIDE([Total Revenue] - [Previous Year Revenue], [Previous Year Revenue])
Repeat Customers = COUNTROWS(FILTER(VALUES(Orders[customer_id]), CALCULATE([Total Orders]) > 1))
Repeat Customer Rate = DIVIDE([Repeat Customers], [Total Customers])
